# ====== Infarm CS (Next.js) — Konfigurasi ======
# Salin file ini menjadi ".env.local" lalu isi nilainya.
# .env.local TIDAK ikut ter-commit (lihat .gitignore).
# Di produksi, isi nilai yang sama di Vercel → Project Settings →
# Environment Variables (Step 15). Jangan pernah menaruh key di kode.

# API key Claude (Anthropic). Ambil di:
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model Claude — default mengikuti Tech Stack di claude.md.
CLAUDE_MODEL=claude-sonnet-4-6

# Maksimum token balasan (balasan CS singkat 2-5 kalimat → 600 cukup).
MAX_TOKENS=600

# ====== Supabase ======
# Isi keduanya untuk MENYALAKAN login + database. Selama masih
# kosong, console berjalan di mode demo (data contoh di memori)
# dan tidak ada layar login. Tidak ada kode yang perlu diubah.
#
# Ambil di: Supabase -> Project Settings -> API
# Jalankan supabase/schema.sql & schema-kb.sql lebih dulu.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# JANGAN pernah menaruh service_role key di berkas ini atau di
# variabel NEXT_PUBLIC_* mana pun — kunci itu menembus seluruh
# aturan RLS dan akan ikut terkirim ke peramban.

# ====== Pengaman saldo (opsional) ======
# AI_TEST_LOCK=1 menolak SEMUA panggilan berbayar ke Claude sebelum
# dikirim. Jalur template tetap berjalan, jadi console masih bisa
# didemokan — yang mati hanya yang memotong saldo.
#
# Nyalakan saat menyerahkan proyek ke orang lain, saat menjalankan
# agen coding, atau kapan pun tidak ingin ada panggilan tak terduga.
# Hapus barisnya (atau isi 0) lalu jalankan ulang server untuk membuka.
# AI_TEST_LOCK=1

# ====== Voyage (Gerbang 2 — Pengenal Maksud) ======
# Mengubah kalimat jadi deretan angka supaya "nem oilnya dipakenya
# gmn kak" bisa ketemu template yang sama dengan "cara pakai neem
# oil" — walau tidak ada satu kata pun yang sama persis.
#
# Ambil di: https://dashboard.voyageai.com/ -> API Keys
# Tempel setelah tanda = tanpa spasi dan tanpa tanda kutip.
#
# INI KUNCI SISI SERVER. Namanya sengaja TIDAK diawali
# NEXT_PUBLIC_ supaya tidak ikut terkirim ke peramban pengunjung.
VOYAGE_API_KEY=

# Nama model. Kosongkan untuk memakai voyage-4-lite.
# WAJIB dicocokkan dengan nama persis di dasbor Voyage — nama yang
# salah membuat panggilan gagal dengan HTTP 400.
#
# Periksa juga dukungan bahasa Indonesianya. Pelanggan menulis
# "gmn", "brp", "kk" — kalau modelnya berpusat pada bahasa Inggris,
# justru kalimat itulah yang paling dulu meleset, padahal itu alasan
# Gerbang 2 dibangun.
# VOYAGE_MODEL=voyage-4-lite

# Tarif untuk laporan perkiraan biaya. Cocokkan dengan halaman harga
# Voyage — angka yang usang membuat laporan biaya diam-diam bohong.
# VOYAGE_USD_PER_MTOK=0.02
# USD_TO_IDR=16500

# Mengunci Voyage SENDIRIAN, tanpa ikut mengunci Claude. Berguna
# saat kuota gratis 200 juta token menipis. AI_TEST_LOCK=1 di atas
# tetap mengunci keduanya sekaligus.
# VOYAGE_LOCK=1
