# ====== Infarm CS Backend — Konfigurasi ======
# Salin file ini menjadi ".env" lalu isi nilainya.

# API key Claude (Anthropic). Dapatkan di: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model Claude (default sesuai Tech Stack claude.md)
CLAUDE_MODEL=claude-sonnet-4-6

# Maksimum token balasan (jawaban CS singkat 2-5 kalimat → 600 cukup)
MAX_TOKENS=600

# Port server
PORT=3000

# ====== Pengaman saldo (opsional) ======
# AI_TEST_LOCK=1 menolak SEMUA panggilan berbayar ke Claude sebelum
# dikirim. Jalur template tetap berjalan, jadi console masih bisa
# didemokan — yang mati hanya yang memotong saldo.
#
# Nyalakan saat menyerahkan proyek ke orang lain, saat menjalankan
# agen coding, atau kapan pun tidak ingin ada panggilan tak terduga.
# Hapus barisnya (atau isi 0) lalu jalankan ulang server untuk membuka.
# AI_TEST_LOCK=1
